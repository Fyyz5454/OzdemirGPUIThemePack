{
  "$schema": "https://app.kilo.ai/config.json",
  "lsp": true,
  "mcp": {
    "sudo": {
      "type": "local",
      "command": ["/home/omer/.local/bin/sudo-mcp"],
      "enabled": true,
      "timeout": 60000
    },
    "debugger": {
      "type": "local",
      "command": ["npx", "-y", "@debugmcp/mcp-debugger"],
      "enabled": true,
      "timeout": 60000
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest", "--headless", "--browser", "chrome"],
      "enabled": true,
      "timeout": 60000
    }
  }
}
